# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# Configure this under settings or in your local .env file.
OPENROUTER_API_KEY=ADD_YOUR_OPENROUTER_API_KEY

# OPENROUTER_MODEL: Configurable OpenRouter model (e.g. google/gemini-2.5-flash)
OPENROUTER_MODEL=ADD_YOUR_OPENROUTER_MODEL

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_PER_IP=10
AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=5
AUTH_BACKOFF_BASE_SEC=30
AUTH_BACKOFF_MULTIPLIER=2.0

PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX_REQUESTS=100

USER_RATE_LIMIT_WINDOW_MS=60000
USER_RATE_LIMIT_MAX_REQUESTS=300

SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=50

# File Security Thresholds
MAX_FILE_SIZE_BYTES=20971520
MAX_IMAGE_SIZE_BYTES=26214400

# Demo Guest Access Configuration
DEMO_GUEST_ENABLED=true
DEMO_GUEST_SESSION_MINUTES=30
DEMO_GUEST_LOGIN_LIMIT_PER_MINUTE=20
DEMO_GUEST_CHAT_LIMIT_PER_MINUTE=10
DEMO_GUEST_TENANT_ID=guest-demo

